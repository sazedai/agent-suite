# Environment Configuration
# Copy this file to .env and fill in your values

# LLM Provider
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1

# Agent Settings
AGENT_MODEL=gpt-4o
AGENT_TEMPERATURE=0.7
AGENT_MAX_TOKENS=4096

# Storage
DATABASE_URL=sqlite+aiosqlite:///./agentsuite.db

# Integrations (optional)
HUBSPOT_API_KEY=
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_STORE_URL=
GMAIL_CREDENTIALS_PATH=
GOOGLE_CALENDAR_CREDENTIALS_PATH=
SLACK_BOT_TOKEN=
STRIPE_API_KEY=
SEMRUSH_API_KEY=
AHREFS_API_KEY=

# Search
SERPER_API_KEY=
BRAVE_SEARCH_API_KEY=
